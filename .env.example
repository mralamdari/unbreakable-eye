


# .env file
PROJECT_NAME="Unbreakable Eye"
LOG_LEVEL=INFO

# --- INPUT ---
# Use '0' to test with your laptop webcam immediately.
# Or put a real RTSP URL here.
RTSP_URL=data/cr-mini.mp4 

