# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-64-char-random-string
LOG_LEVEL=INFO
SECURE_COOKIES=false          # Set to "true" in production with HTTPS
CORS_ORIGINS=                 # Comma-separated allowed origins (e.g. https://example.com)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These must match what docker-compose.yml sets for the postgres service.
POSTGRES_HOST=postgres          # service name in docker-compose, or IP/hostname
POSTGRES_PORT=5432
POSTGRES_DB=unbreakable_eye
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Connection pool sizing:
#   min = always-open connections (keep warm)
#   max = hard cap (set to CPU count or slightly above)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_ARCH=yolo_onnx
MODEL_ID=models/yolo_onnx/yolo12s.onnx
DETECTOR_BACKEND=ultralytics_onnx
CONF_THRESHOLD=0.45
IOU_THRES=0.45
NMS_THRESHOLD=0.45
CLASS_AGNOSTIC=true
DEVICE=cpu

# ── Re-ID ─────────────────────────────────────────────────────────────────────
FEATURE_EXTRACTOR_MODEL=models/osnet_x0_25_256x128.onnx
EMBEDDING_DIM=512
REID_THRESHOLD=0.55
DIVERSITY_THRESHOLD=0.25
SIZE_RATIO_GATE=2.0

# ── Pipeline ──────────────────────────────────────────────────────────────────
WORKING_HEIGHT=512
WORKING_WIDTH=512
WORKING_CHANNELS=3
NATIVE_HEIGHT=1080
NATIVE_WIDTH=1920
SOFT_SPEED_THRESHOLD=300.0
LAMBDA_SPATIAL=0.3
LAMBDA_DISTANCE=0.1

# ── HuggingFace ───────────────────────────────────────────────────────────────
# HF_MODEL_REPONAME=
HF_MODEL_FILENAME=onnx/model_quantized.onnx

# ── Privacy ──────────────────────────────────────────────────────────────────
PRIVACY_BLUR=false               # Blur faces in the video stream (GDPR)
PRIVACY_BLUR_KERNEL=51           # Gaussian blur kernel size

# ── Heatmap ──────────────────────────────────────────────────────────────────
HEATMAP_ENABLED=true             # Show heatmap overlay on video feed
HEATMAP_RETENTION_SECONDS=3600   # Rolling window (default 1 hour)
HEATMAP_OPACITY=0.25             # Heatmap overlay opacity
HEATMAP_RADIUS=40                # Gaussian radius for each position
HEATMAP_DECAY_RATE=0.95          # Exponential decay per second

# ── Analytics Retention ──────────────────────────────────────────────────────
RAW_RETENTION_DAYS=7             # Raw detection_events kept for 7 days
AGGREGATE_RETENTION_DAYS=30      # analytics_hourly kept for 30 days
ANALYTICS_BATCH_SIZE=100         # Batch size for bulk inserts
ANALYTICS_FLUSH_INTERVAL=5.0     # Seconds between analytics flushes

# ── Zones ────────────────────────────────────────────────────────────────────
DEFAULT_ZONE_NAME=Full Frame
