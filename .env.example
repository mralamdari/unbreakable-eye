MODEL_ID=yolo12s.onnx
# MODEL_ID=yolo11n-pose.onnx
MODEL_ARCH=yolo_onnx

# --- THRESHOLDS ---
CONF_THRESHOLD=0.2
IOU_THRES=0.4

SECRET_KEY=change-me-to-a-random-64-char-string
DB_PATH=data/db/surveillance.db

FEATURE_EXTRACTOR_MODEL=models/osnet.onnx

REID_THRESHOLD=0.45
DIVERSITY_THRESHOLD=0.25

WORKING_HEIGHT=512
WORKING_WIDTH=512

NATIVE_HEIGHT=1080
NATIVE_WIDTH=1920





# MODEL_ID=rfdetr_small-ONNX
