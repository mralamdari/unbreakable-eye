# Dockerfile.pi — Raspberry Pi 4/5 (ARM64)
# Uses slim Python base optimized for ARM
#
# Build:
#   docker build -f infra/docker/Dockerfile.pi -t unbreakable-eye:pi .
#
# Run:
#   docker run -p 8000:8000 --env-file .env unbreakable-eye:pi

FROM arm64v8/python:3.10-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# System dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libjpeg-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ ./src/
# Models are gitignored and large — mount at runtime via docker-compose volumes
RUN mkdir -p /app/models

# Create non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Pi-optimized defaults — smaller frames for limited CPU
ENV WORKING_WIDTH=256
ENV WORKING_HEIGHT=256
ENV DEVICE=cpu
ENV OMP_NUM_THREADS=4

EXPOSE 8000

CMD ["uvicorn", "src.web.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
